	month = apr,
	year = {2017},
	note = {ISSN: 2640-3498},
	pages = {1094--1103},
	file = {Sokolic et al_2017_Generalization Error of Invariant Classifiers.pdf:/home/qin/Dropbox/experiments/Sokolic et al_2017_Generalization Error of Invariant Classifiers2.pdf:application/pdf},
}
